
@article{wang_association_2019,
	title = {The {Association} {Among} {Social} {Support}, {Self}-{Efficacy}, {Use} of {Mobile} {Apps}, and {Physical} {Activity}: {Structural} {Equation} {Models} {With} {Mediating} {Effects}},
	volume = {7},
	issn = {2291-5222},
	shorttitle = {The {Association} {Among} {Social} {Support}, {Self}-{Efficacy}, {Use} of {Mobile} {Apps}, and {Physical} {Activity}},
	url = {http://mhealth.jmir.org/2019/9/e12606/},
	doi = {10.2196/12606},
	abstract = {Background
              Physical inactivity is a risk factor for chronic noncommunicable diseases. Insufficient physical activity has become an important public health problem worldwide. As mobile apps have rapidly developed, physical activity apps have the potential to improve the level of physical activity among populations.
            
            
              Objective
              This study aimed to evaluate the effect of physical activity apps on levels of physical activity among college students.
            
            
              Methods
              A Web-based questionnaire was used to survey college students in Beijing from December 27, 2017, to January 5, 2018. According to a previous survey, 43\% of college students using physical activity apps and 36\% of those who never used such apps achieved the physical activity recommendations. In this study, the sample size was calculated to be 500. The questionnaire consisted of 5 parts: the use of physical activity apps, sports habits, social support, self-efficacy, and social demographic information. Structural equation modeling was used to test the relationships between the use of physical activity apps, self-efficacy, social support, and level of physical activity.
            
            
              Results
              Of the 1245 participants, 384 college students (30.8\%) used physical activity apps (in the past month). Of these 384 students, 191 (49.7\%) gained new friends via the app. College students who were using physical activity apps had a higher level of physical activity and higher scores for social support and self-efficacy (P{\textless}.001) than those who did not use such apps. The use of physical activity apps significantly affected the mediating effect of physical activity level through social support (beta=.126; P{\textless}.001) and self-efficacy (beta=.294; P{\textless}.001). Gender played an important role in app use, self-efficacy, and physical activity in the mediation model: male users spent more time on physical activity and had higher self-efficacy scores (P{\textless}.001).
            
            
              Conclusions
              This study focused on college students in Beijing and found that the use of physical activity apps is associated with higher physical activity levels among these students. This effect is mainly through the mediation effect of social support and self-efficacy, rather than the direct effect of physical activity apps. The use of physical activity apps is associated with a higher social support level and higher self-efficacy score. Furthermore, a high social support level and high self-efficacy score are associated with higher physical activity levels.},
	language = {en},
	number = {9},
	urldate = {2026-04-04},
	journal = {JMIR mHealth and uHealth},
	author = {Wang, Taotao and Ren, Mengyuan and Shen, Ying and Zhu, Xiaorou and Zhang, Xing and Gao, Min and Chen, Xueying and Zhao, Ai and Shi, Yuhui and Chai, Weizhong and Liu, Xinchuan and Sun, Xinying},
	month = sep,
	year = {2019},
	keywords = {atividade\_fisica, engajamento, suporte\_social, autoeficacia, apps\_sociais},
	pages = {e12606},
	annote = {RESENHA CRÍTICA


Tema: Relação entre suporte social, autoeficácia, uso de aplicativos móveis e prática de atividade física.


Objetivo: Investigar como o suporte social e a autoeficácia influenciam o uso de aplicativos móveis e os níveis de atividade física entre estudantes universitários.


Método: Estudo quantitativo baseado na aplicação de questionários, visando analisar variáveis como uso de aplicativos, suporte social percebido e nível de atividade física.


Resultados principais: Foi identificada uma associação positiva entre o uso de aplicativos móveis, maior suporte social, aumento da autoeficácia e níveis mais elevados de atividade física. Além disso, uma parcela significativa dos usuários relatou a formação de novas conexões sociais por meio dos aplicativos.


Relação com SquadUp: O artigo reforça a importância do componente social em aplicativos voltados à prática esportiva. Nesse contexto, o SquadUp pode se beneficiar ao incorporar funcionalidades que promovam a interação entre usuários, a criação de grupos e o fortalecimento de redes de apoio.


Crítica pessoal:


O artigo apresenta uma análise relevante ao evidenciar a importância do suporte social e da autoeficácia na prática de atividades físicas, demonstrando que a presença de outras pessoas pode aumentar significativamente a motivação dos indivíduos.
Entretanto, na prática, muitos aplicativos atuais não conseguem construir vínculos sociais mais profundos, oferecendo interações superficiais e, em alguns casos, priorizando aspectos comerciais em detrimento do bem-estar dos usuários.
Além disso, a experiência pessoal indica que a ausência de companhia pode ser um fator determinante para a não realização de atividades, reforçando a relevância do componente social.
Assim, apesar de destacar corretamente a importância das relações sociais, o estudo não aprofunda de que forma essas conexões podem ser estruturadas de maneira efetiva, o que abre espaço para o desenvolvimento de soluções mais completas, como o SquadUp.
},
	file = {PDF:C\:\\Users\\guite\\Zotero\\storage\\4MR6Q29N\\Wang et al. - 2019 - The Association Among Social Support, Self-Efficacy, Use of Mobile Apps, and Physical Activity Stru.pdf:application/pdf},
}

@article{crossman_facilitators_2024,
