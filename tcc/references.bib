@article{pradal-cano_using_2020,
	title = {Using {Mobile} {Applications} to {Increase} {Physical} {Activity}: {A} {Systematic} {Review}},
	volume = {17},
	issn = {1660-4601},
	shorttitle = {Using {Mobile} {Applications} to {Increase} {Physical} {Activity}},
	url = {https://www.mdpi.com/1660-4601/17/21/8238},
	doi = {10.3390/ijerph17218238},
	abstract = {Unhealthy diet and physical inactivity—major risk factors for the main non-communicable diseases—can be addressed by mobile health applications. Using an evidence-based systematic review design, we analysed studies on mobile applications to foster physical activity to determine whether they met the objective of increasing adults’ physical activity. A bibliographic search was conducted in October 2020 using PubMed, Cochrane Library Plus, Biomed Central, Psychology Database, and SpringerLink, retrieving 191 articles. After titles and abstracts were reviewed, 149 articles were excluded, leaving 42 articles for a full-text review, of which 14 met the inclusion criteria. Despite differences in study duration, design, and variables, 13 of the 14 studies reported that applications were effective in increasing physical activity and healthy habits as dietary behaviour. However, further longer-term studies with larger samples are needed to confirm the effectiveness of mobile health applications in increasing physical activity.},
	language = {en},
	number = {21},
	urldate = {2026-04-04},
	journal = {International Journal of Environmental Research and Public Health},
	author = {Pradal-Cano, Laura and Lozano-Ruiz, Carolina and Pereyra-Rodríguez, José Juan and Saigí-Rubió, Francesc and Bach-Faig, Anna and Esquius, Laura and Medina, F. Xavier and Aguilar-Martínez, Alicia},
	month = nov,
	year = {2020},
	keywords = {atividade\_fisica, apps\_mobile, engajamento, saude, monitoramento},
	pages = {8238},
	annote = {RESENHA CRÍTICA


Tema: Uso de aplicativos móveis para aumento da atividade física.


Objetivo: Analisar, por meio de revisão sistemática, a eficácia de aplicativos móveis em promover aumento nos níveis de atividade física entre usuários.


Método: Revisão sistemática da literatura, analisando múltiplos estudos que investigam o impacto de aplicativos de atividade física em diferentes públicos.


Resultados principais: Os aplicativos móveis apresentam potencial para aumentar os níveis de atividade física, especialmente quando incluem funcionalidades como monitoramento, feedback, definição de metas e envio de notificações. No entanto, a eficácia varia conforme o nível de engajamento do usuário e o design do aplicativo.


Relação com SquadUp: O artigo sustenta a ideia de que aplicativos móveis podem influenciar positivamente o comportamento dos usuários em relação à prática de atividades físicas. No contexto do SquadUp, reforça a importância de desenvolver funcionalidades que incentivem o engajamento e a continuidade da prática esportiva.


Crítica pessoal:


O artigo apresenta contribuições relevantes ao demonstrar o potencial de aplicativos móveis no aumento da atividade física, especialmente por meio de funcionalidades como monitoramento, metas e notificações.
No entanto, tais estratégias não são suficientes, por si só, para garantir a continuidade da prática esportiva, uma vez que fatores pessoais e profissionais impactam diretamente a disponibilidade e motivação dos usuários.
Além disso, observa-se a ausência de um componente social mais estruturado, visto que muitos desses aplicativos funcionam de forma individual, o que pode limitar o engajamento a longo prazo.
Dessa forma, embora o artigo contribua para o entendimento do uso de tecnologia na promoção da atividade física, ainda há espaço para soluções que integrem aspectos sociais de forma mais efetiva, como a interação entre usuários proposta pelo SquadUp.
},
	file = {Full Text PDF:C\:\\Users\\guite\\Zotero\\storage\\BWU6284W\\Pradal-Cano et al. - 2020 - Using Mobile Applications to Increase Physical Activity A Systematic Review.pdf:application/pdf},
}
