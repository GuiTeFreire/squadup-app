# URL base da API do backend (FastAPI). Variáveis EXPO_PUBLIC_* são inlinadas em build time
# pelo Expo e ficam visíveis no bundle final — nunca colocar segredos aqui.
EXPO_PUBLIC_API_URL=http://localhost:8000

# `localhost` só funciona no `npm run web`. Em Expo Go (dispositivo físico ou emulador),
# usar o IP da rede local da máquina de desenvolvimento, ex.:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
# ou rodar `expo start --tunnel`.

# Build de apresentação / produção (Railway):
# EXPO_PUBLIC_API_URL=https://squadup-api.up.railway.app
